{
  "//": "参考模板。实际渲染由 lib/singbox.sh 的 render_server_config() 完成，",
  "//2": "因为 Hy2 带宽段(adaptive/fixed)和 AnyTLS 入站是条件生成的，用纯占位符不好表达。",
  "//3": "此文件仅供你查看最终结构，改配置请改 config.conf 后重跑 install.sh。",
  "//4": "v1.4：UNLOCK_IP 非空时才有 unlock DNS 服务器和 route.rules 里那条 resolve 规则。",

  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [
      { "type": "tls", "tag": "google",     "server": "8.8.8.8" },
      { "type": "tls", "tag": "cloudflare", "server": "1.1.1.1" },
      { "type": "udp", "tag": "unlock",     "server": "__UNLOCK_IP__", "server_port": 53 }
    ],
    "strategy": "ipv4_only",
    "final": "google"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": "__HY2_PORT__",
      "ignore_client_bandwidth": true,
      "users": [
        { "name": "joe", "password": "__HY2_PASSWORD__" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__HY2_SNI__",
        "certificate_path": "/etc/sing-box/certs/server.crt",
        "key_path": "/etc/sing-box/certs/server.key"
      }
    },
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": "__REALITY_PORT__",
      "users": [
        { "uuid": "__UUID__", "flow": "xtls-rprx-vision" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__REALITY_SNI__",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "__REALITY_HANDSHAKE_SERVER__",
            "server_port": "__REALITY_HANDSHAKE_PORT__"
          },
          "private_key": "__REALITY_PRIVATE_KEY__",
          "short_id": [ "__REALITY_SHORT_ID__" ]
        }
      }
    },
    {
      "//": "ENABLE_ANYTLS=1 时才生成；复用 Hy2 的自签证书",
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": "__ANYTLS_PORT__",
      "users": [
        { "name": "joe", "password": "__ANYTLS_PASSWORD__" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__ANYTLS_SNI__",
        "certificate_path": "/etc/sing-box/certs/server.crt",
        "key_path": "/etc/sing-box/certs/server.key"
      }
    },
    {
      "//": "v1.4：只听 127.0.0.1 的本机测试入口（LOCAL_TEST_PORT），给 unlock-check.sh 用",
      "type": "mixed",
      "tag": "local-test-in",
      "listen": "127.0.0.1",
      "listen_port": 10808
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "rules": [
      {
        "//": "命中这些域名 → 改用解锁 DNS 解析，再直连解析出的 IP",
        "domain_suffix": [ "netflix.com", "netflix.net", "nflximg.com", "nflximg.net", "nflxext.com", "nflxso.net",
                           "disneyplus.com", "disney-plus.net", "disneystreaming.com", "bamgrid.com" ],
        "action": "resolve",
        "server": "unlock",
        "strategy": "ipv4_only"
      }
    ],
    "default_domain_resolver": "google"
  }
}
